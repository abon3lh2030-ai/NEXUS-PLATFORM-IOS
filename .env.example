# Supabase project (same as the NEXUS website). The anon key is public by design; data is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXUS API (the existing backend). From the iOS simulator, http://localhost:8080 reaches the API on this Mac.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
